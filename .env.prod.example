# Production environment variables for AI Career OS
# Copy to .env.prod and fill in all values
# NEVER commit this file to version control

# =============================================================================
# Database (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# =============================================================================
# MinIO (Object Storage)
# =============================================================================
MINIO_ROOT_USER=careeros-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# =============================================================================
# Application Security
# =============================================================================
# JWT_SECRET: >= 64 random characters, used for JWT signing
JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS

# Internal service-to-service authentication token
# Must be identical in backend and ai-service
INTERNAL_API_TOKEN=CHANGE_ME_STRONG_INTERNAL_TOKEN

# =============================================================================
# AI Providers (Production requires real providers)
# =============================================================================
# LLM Provider: openai_compat | anthropic | ollama
# Use openai_compat for OpenAI-compatible APIs (OpenAI, Azure, etc.)
LLM_PROVIDER=openai_compat
LLM_API_KEY=CHANGE_ME_OPENAI_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding Provider: openai | ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=CHANGE_ME_OPENAI_API_KEY
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=prod
APP_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api/v1
# Origin the reset mail links back to. Must be the public URL of the app: unset,
# every password-reset email points the user at http://localhost:3000.
APP_WEB_BASE_URL=https://your-domain.com

# =============================================================================
# Email (password reset, and the weekly letter)
# =============================================================================
# console logs letters instead of sending them (development only). Production
# uses smtp: a host and a from address are required, and the call is capped at
# 5 s, so a dead relay fails the request instead of holding it open.
APP_EMAIL_PROVIDER=smtp
APP_EMAIL_FROM=no-reply@your-domain.com
APP_EMAIL_SMTP_HOST=smtp.example.com
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
APP_EMAIL_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# STARTTLS on 587, SSL from the first byte on 465: exactly one is true.
APP_EMAIL_SMTP_STARTTLS=true
APP_EMAIL_SMTP_SSL=false
# Signs the unsubscribe links every letter carries. Generate 32+ random bytes
# (openssl rand -base64 48); rotating it retires every link already mailed.
APP_MAIL_LINK_SECRET=CHANGE_ME_MAIL_LINK_SECRET
# Seals every enrolled authenticator seed at rest (roadmap 36.1). Generate 32+
# random bytes (openssl rand -base64 48). Rotating it makes every existing seed
# unreadable: those accounts sign in on their password until they enroll again,
# so the runbook's rotation note applies (docs/DEPLOYMENT.md).
APP_MFA_SECRET=CHANGE_ME_MFA_SECRET

# =============================================================================
# Web Push (optional; roadmap 33.2)
# =============================================================================
# Both VAPID keys or neither: leave both empty to keep push off (browsers can still
# register, but no wake leaves and the boot logs "push is not configured"). Filling
# only one half refuses the boot. Generate a pair with
# `npx web-push generate-vapid-keys`; the public key is the browser's
# `applicationServerKey`, the private key never leaves the server. The public key is also
# what the frontend image is built against, so compose passes this value as a build arg;
# changing it needs a frontend rebuild.
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
# RFC 8292's `sub` contact (mailto: or https:). Empty falls back to APP_WEB_BASE_URL.
APP_PUSH_CONTACT=
APP_PUSH_TTL_SECONDS=43200

# Internal service URLs (Docker network)
BACKEND_BASE_URL=http://backend:8080
AI_SERVICE_BASE_URL=http://ai-service:8000
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=careeros-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# =============================================================================
# Database Connection (Backend uses these individually)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0
# Redis backs only the rate limiter and the health ping, so failing fast beats
# waiting: these keep /api/v1/health answering in half a second during an outage.
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=careeros-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# AI Service URL (for backend to call ai-service)
AI_SERVICE_BASE_URL=http://ai-service:8000

# =============================================================================
# Rate limits (per minute: auth per client IP, ai per user, mail per account,
# mfa per signed-in account) and retrieval tuning
# =============================================================================
RATELIMIT_AUTH_PER_MINUTE=10
RATELIMIT_AI_PER_MINUTE=30
RATELIMIT_MAIL_PER_MINUTE=5
RATELIMIT_MFA_PER_MINUTE=5
# Days an expired credential row (refresh/reset/address-change token) is kept past
# its expiry before the nightly retention sweep deletes it.
RETENTION_EXPIRED_TOKEN_DAYS=30
RERANK_MODE=llm            # llm | none
MINIO_BUCKET=careeros-files
# Must stay 8080: docker-compose.prod.yml publishes "8080:8080" literally, so a
# different value here would move the app off the port the host maps.
BACKEND_PORT=8080
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# =============================================================================
# AI Service Specific
# =============================================================================
# DATABASE_URL is constructed from the above parts in ai-service
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0