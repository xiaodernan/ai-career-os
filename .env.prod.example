# Production environment variables for AI Career OS
# Copy to .env.prod and fill in all values
# NEVER commit this file to version control

# =============================================================================
# Database (PostgreSQL + pgvector)
# =============================================================================
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# Redis
# =============================================================================
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# =============================================================================
# MinIO (Object Storage)
# =============================================================================
MINIO_ROOT_USER=careeros-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# =============================================================================
# Application Security
# =============================================================================
# JWT_SECRET: >= 64 random characters, used for JWT signing
JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS

# Internal service-to-service authentication token
# Must be identical in backend and ai-service
INTERNAL_API_TOKEN=CHANGE_ME_STRONG_INTERNAL_TOKEN

# =============================================================================
# AI Providers (Production requires real providers)
# =============================================================================
# LLM Provider: openai_compat | anthropic | ollama
# Use openai_compat for OpenAI-compatible APIs (OpenAI, Azure, etc.)
LLM_PROVIDER=openai_compat
LLM_API_KEY=CHANGE_ME_OPENAI_API_KEY
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embedding Provider: openai | ollama
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=CHANGE_ME_OPENAI_API_KEY
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# =============================================================================
# Application Configuration
# =============================================================================
APP_ENV=prod
APP_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://your-domain.com/api/v1

# Internal service URLs (Docker network)
BACKEND_BASE_URL=http://backend:8080
AI_SERVICE_BASE_URL=http://ai-service:8000
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=careeros-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# =============================================================================
# Database Connection (Backend uses these individually)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379/0

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=careeros-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_PASSWORD

# AI Service URL (for backend to call ai-service)
AI_SERVICE_BASE_URL=http://ai-service:8000

# =============================================================================
# AI Service Specific
# =============================================================================
# DATABASE_URL is constructed from the above parts in ai-service
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0