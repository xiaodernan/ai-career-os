# env & secrets
# `.env*` covers .env, .env.local and the .env.prod that docker-compose.prod.yml reads.
# The negations keep the templates that ARE meant to be committed.
#
# This replaced `*.env !.env.example` on one line -- git reads a line as a single
# pattern, so that rule excluded nothing and `.env.prod`, which holds the production
# secrets, was committable.
.env*
!.env.example
!.env.prod.example

# node / next
node_modules/
.next/
out/
*.tsbuildinfo

# java
backend/target/
*.class
.mvn/wrapper/maven-wrapper.jar

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# data & artifacts
# Root-anchored on purpose: a bare `storage/` matched the Java package
# backend/src/main/java/com/careeros/storage/ and kept four shipped sources out of the repository.
/storage/
ai-service/evals/reports/
playwright-report/
test-results/

# misc
.DS_Store
*.log
.idea/
.vscode/

# assistant workspace (local scratch, not project source)
.workbuddy-ai/
.scratch/
