# ================= AI Career OS — environment template =================
# Copy to .env and fill in. Never commit .env.

# ---- infra ----
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:16380/0
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=careeros-files

# ---- backend (Spring Boot) ----
JWT_SECRET=generate-a-64+char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
INTERNAL_API_TOKEN=shared-secret-between-backend-and-ai-service
BACKEND_PORT=8080
APP_CORS_ORIGINS=http://localhost:3000
# Origin the reset mail links back to (must be where the browser app is served)
APP_WEB_BASE_URL=http://localhost:3000
# Where the backend reaches ai-service (docker-compose overrides this to ai-service:8000)
AI_SERVICE_BASE_URL=http://localhost:8000
# Postgres, when the backend runs outside compose (compose sets these itself)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Redis client timeouts. Both are 500ms on purpose: Redis backs only the rate limiter
# and the health ping, so an outage should degrade /api/v1/health in half a second
# rather than stall every request on a client timeout.
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
# Rate limits, per minute: auth is per client IP, ai is per user, mail is per account
RATELIMIT_AUTH_PER_MINUTE=10
RATELIMIT_AI_PER_MINUTE=30
# Each address-move request mails two letters, so this ceiling is letters/2 per minute
RATELIMIT_MAIL_PER_MINUTE=5
# Days an expired refresh/reset/address-change token row is kept past its expiry before
# the 04:47 sweep deletes it. Nothing reads an expired row; the grace is for late
# requests and investigations.
RETENTION_EXPIRED_TOKEN_DAYS=30
# ---- email ----
# console (the default) logs each letter instead of sending it; smtp hands it to
# a relay. smtp refuses to boot without a host and a from address. On 587 use
# STARTTLS, on 465 use SSL from the first byte -- exactly one of the two.
APP_EMAIL_PROVIDER=console
APP_EMAIL_FROM=no-reply@example.com
APP_EMAIL_SMTP_HOST=
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_STARTTLS=true
APP_EMAIL_SMTP_SSL=false
# Signs the unsubscribe links every letter carries. Dev's default is written in
# application.yml and is stable across restarts, so links in old dev mail keep
# working; prod must set its own, and changing it retires every link already mailed.
APP_MAIL_LINK_SECRET=dev-only-mail-link-secret-please-change-me-0123456789abcdef

# ---- ai-service (FastAPI) ----
# The port is not configurable: the image hardcodes --port 8000 (one worker, because the
# task bus is a module-level dict in that process). Nothing reads a port variable.
DATABASE_URL=postgresql://career_os:change-me@localhost:5432/career_os
BACKEND_BASE_URL=http://localhost:8080

# LLM provider: openai_compat | anthropic | ollama | mock (mock is TEST-ONLY)
LLM_PROVIDER=openai_compat
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Embeddings: openai | ollama | hash (hash = offline dev only, retrieval quality limited)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANK_MODE=llm            # llm | none
# Voice (19.6): none | openai_compat | mock. `none` keeps the interview
# text-only and the page falls back to the browser's own speech APIs; the
# real provider serves /audio/transcriptions and /audio/speech; mock is
# TEST-ONLY (refused when APP_ENV=prod).
VOICE_PROVIDER=none
VOICE_BASE_URL=
VOICE_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
APP_ENV=dev                # prod refuses provider=mock

# ---- frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
