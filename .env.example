# ================= AI Career OS — environment template =================
# Copy to .env and fill in. Never commit .env.

# ---- infra ----
POSTGRES_DB=career_os
POSTGRES_USER=career_os
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:16380/0
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=careeros-files

# ---- backend (Spring Boot) ----
JWT_SECRET=generate-a-64+char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
INTERNAL_API_TOKEN=shared-secret-between-backend-and-ai-service
# The commit the image bakes, for `/health` transparency (Epic 78): the dev stack
# leaves this empty and gets the literal "dev"; set to HEAD when booting the jar
APP_BUILD_SHA=dev
BACKEND_PORT=8080
APP_CORS_ORIGINS=http://localhost:3000
# Origin the reset mail links back to (must be where the browser app is served)
APP_WEB_BASE_URL=http://localhost:3000
# Where the backend reaches ai-service (docker-compose overrides this to ai-service:8000)
AI_SERVICE_BASE_URL=http://localhost:8000
# Optional: comma-separated origins when several ai-service nodes answer (Epic 85.2).
# Empty means the base URL above is the only instance; set it to spread calls across nodes.
AI_SERVICE_INSTANCES=
# Service registry (Epic 98). Off by default: the configured lists above are the whole
# topology and no registry process is required. The compose stack activates the
# `eureka` profile and sets these itself; a native run that wants the registry exports
# them by hand.
BACKEND_EUREKA_ENABLED=false
BACKEND_EUREKA_REGISTER=true
BACKEND_EUREKA_FETCH=false
BACKEND_EUREKA_PREFER_IP=false
# Lease tuning (Epic 108.x): renew every 10s, expire after 30s of silence -- the
# defaults application.yml carries. A slower pair trades responsiveness for less
# renewal chatter in opt-in discovery setups.
BACKEND_EUREKA_LEASE_RENEWAL_SECONDS=10
BACKEND_EUREKA_LEASE_EXPIRATION_SECONDS=30
# Spring Cloud Config (Epic 101): opt-in externalized configuration. false keeps
# the local file the only source; fail-fast stays false so an opted-out boot never
# depends on a Config Server being up.
SPRING_CLOUD_CONFIG_ENABLED=false
SPRING_CLOUD_CONFIG_FAIL_FAST=false
BACKEND_HOSTNAME=localhost
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
# Postgres, when the backend runs outside compose (compose sets these itself)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Redis client timeouts. Both are 500ms on purpose: Redis backs only the rate limiter
# and the health ping, so an outage should degrade /api/v1/health in half a second
# rather than stall every request on a client timeout.
REDIS_TIMEOUT=500ms
REDIS_CONNECT_TIMEOUT=500ms
# Rate limits, per minute: auth is per client IP, ai is per user, mail is per account,
# mfa counts the code guesses made from one signed-in account, and inbound counts
# letters posted to one forwarding address (the provider is one IP for every account)
RATELIMIT_AUTH_PER_MINUTE=10
RATELIMIT_AI_PER_MINUTE=30
# Each address-move request mails two letters, so this ceiling is letters/2 per minute
RATELIMIT_MAIL_PER_MINUTE=5
RATELIMIT_MFA_PER_MINUTE=5
RATELIMIT_INBOUND_PER_MINUTE=10
# Days an expired refresh/reset/address-change token row is kept past its expiry before
# the 04:47 sweep deletes it. Nothing reads an expired row; the grace is for late
# requests and investigations.
RETENTION_EXPIRED_TOKEN_DAYS=30
# Days a retired document is kept after the delete that retired it. The row and the
# chunks indexed from it are the audit record of what the AI once quoted, and the
# nightly sweep purges them -- with the object behind their key -- once this window
# has passed. Raise it to keep that record longer; the rows stay unquotable either way.
RETENTION_RETIRED_DOCUMENT_DAYS=180
# Days an object the bucket holds has to be unseen by every row before the same nightly
# sweep reclaims it. Bytes are stored a moment before the row that names them is written,
# so this window is what keeps an upload still in flight from being judged garbage; a
# rollback between the two leaves an object nothing will ever name, and this is what
# eventually takes it. Raise it only if uploads can be slow to commit their rows.
RETENTION_UNNAMED_OBJECT_DAYS=7
# ---- email ----
# console (the default) logs each letter instead of sending it; smtp hands it to
# a relay. smtp refuses to boot without a host and a from address. On 587 use
# STARTTLS, on 465 use SSL from the first byte -- exactly one of the two.
APP_EMAIL_PROVIDER=console
APP_EMAIL_FROM=no-reply@example.com
APP_EMAIL_SMTP_HOST=
APP_EMAIL_SMTP_PORT=587
APP_EMAIL_SMTP_USERNAME=
APP_EMAIL_SMTP_PASSWORD=
APP_EMAIL_SMTP_STARTTLS=true
APP_EMAIL_SMTP_SSL=false
# Signs the unsubscribe links every letter carries. Dev's default is written in
# application.yml and is stable across restarts, so links in old dev mail keep
# working; prod must set its own, and changing it retires every link already mailed.
APP_MAIL_LINK_SECRET=dev-only-mail-link-secret-please-change-me-0123456789abcdef
# Seals every enrolled authenticator seed at rest (roadmap 36.1). Dev's default is
# published and stable so a dev reboot can still read the seeds it wrote; prod must
# set its own, and changing it makes every existing seed unreadable (those accounts
# sign in on their password until they enroll again).
APP_MFA_SECRET=dev-only-mfa-secret-please-change-me-0123456789abcdef
# The receiving domain replies are forwarded to (roadmap 37.1). Empty means inbound
# mail is off: the settings card says so and the webhook 404s, so no address that
# bounces is ever handed out. With a domain, a provider's inbound route posts to
# /api/v1/inbound/mail/<signed local part> (docs/DEPLOYMENT.md has the Postmark setup).
APP_INBOUND_DOMAIN=

# ---- web push (roadmap 33.2) ----
# Both VAPID keys or neither. With neither, browsers can still register but no push
# leaves the backend (it logs "push is not configured" at boot); with half a pair the
# boot is refused. The public key is the browser's `applicationServerKey` (an
# uncompressed P-256 point, base64url); the private key is the 32-byte scalar or a
# PKCS#8 blob, base64url. Generate a pair with `npx web-push generate-vapid-keys`.
# The public key is also what the frontend is built against (NEXT_PUBLIC_VAPID_PUBLIC_KEY),
# so compose passes this value into the frontend image; do not give the two different keys.
APP_PUSH_VAPID_PUBLIC_KEY=
APP_PUSH_VAPID_PRIVATE_KEY=
# RFC 8292's `sub` contact (mailto: or https:). Empty falls back to APP_WEB_BASE_URL.
APP_PUSH_CONTACT=
# How long a push service may hold a wake (RFC 8030), in seconds; 43200 = 12 hours.
APP_PUSH_TTL_SECONDS=43200

# ---- ai-service (FastAPI) ----
# The port is not configurable: the image hardcodes --port 8000 (one worker, because the
# task bus is a module-level dict in that process). Nothing reads a port variable.
DATABASE_URL=postgresql://career_os:change-me@localhost:5432/career_os
BACKEND_BASE_URL=http://localhost:8080

# LLM provider: mock | openai_compat | anthropic | ollama.
# The example ships offline-first: mock answers every AI call with the deterministic
# double and needs no key, which is what makes a fresh `docker compose --profile app up`
# a working stack instead of one that 500s on each AI endpoint. mock is refused when
# APP_ENV=prod. For real calls switch to openai_compat (or anthropic/ollama) and fill
# LLM_API_KEY -- the production checklist lives in docs/DEPLOYMENT.md.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Embeddings: hash | openai | ollama. hash = the offline demo pair for mock above
# (retrieval quality limited); openai needs EMBEDDING_API_KEY.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
RERANK_MODE=llm            # llm | none
# Voice (19.6): none | openai_compat | mock. `none` keeps the interview
# text-only and the page falls back to the browser's own speech APIs; the
# real provider serves /audio/transcriptions and /audio/speech; mock is
# TEST-ONLY (refused when APP_ENV=prod).
VOICE_PROVIDER=none
VOICE_BASE_URL=
VOICE_API_KEY=
VOICE_STT_MODEL=whisper-1
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
APP_ENV=dev                # prod refuses provider=mock

# ---- frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
