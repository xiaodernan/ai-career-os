<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The gateway rides Boot 3.5.16 rather than the backend's 3.5.5: the offline
    repository carries the reactive starter only at the later patch, and Spring
    Cloud 2025.0.3 accepts any 3.5.x. The two processes stay wire-compatible
    because neither shares a classpath with the other.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.careeros</groupId>
  <artifactId>career-os-gateway</artifactId>
  <version>0.1.0</version>
  <name>ai-career-os-gateway</name>
  <description>Edge gateway for the AI Career OS (Spring Cloud Gateway)</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The release train the backend already rides (Epic 85). -->
    <spring-cloud.version>2025.0.3</spring-cloud.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <!--
      88.2: the route gets a circuit around the backend. The reactive starter is the
      one that composes with the gateway's own chain; the servlet-era factory the
      backend uses would sit on the wrong side of the exchange.
    -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>
    <!--
      91.1: `lb://backend` needs a load-balancer; the gateway starter's webflux module
      does not pull it by default in this release train. The cache starter it would
      drag in is not used by this process, and the local repository only carries the
      later patch, so excluding it keeps the offline build honest.
    -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-cache</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!--
      89.2: the edge's own limiter. Resilience4j is already on the classpath through
      the circuit starter; asking for the limiter module directly keeps the dependency
      explicit rather than relying on a transitively-visible class.
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-ratelimiter</artifactId>
    </dependency>
    <!--
      98.1: `lb://backend` can be answered by a registry instead of a configuration
      list. The client stays inert until `eureka.client.enabled` is true, so a laptop
      with no registry still starts and routes through the simple list; the `eureka`
      profile is what turns the registry into the answer.
    -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <!-- Epic 101: opt-in externalized configuration via Spring Cloud Config. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <!-- Pinned to the version already in the local repository: the offline repo
           does not carry the 1.15.12 managed by Boot 3.5.16, and the backend uses 1.15.3. -->
      <version>1.15.3</version>
    </dependency>
    <!--
      Epic 120: the edge's budget has to be one budget across replicas, and that needs a
      counter every replica can see. The reactive template keeps the call on the event
      loop (Lettuce is non-blocking underneath); a servlet-style RedisTemplate here would
      block a gateway thread per rate-limit decision, which is the one place the edge
      cannot afford it. The starter is the version this Boot parent manages, and it is
      already in the offline repository.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.projectreactor</groupId>
      <artifactId>reactor-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
